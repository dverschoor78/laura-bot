# ============================================================
# Projeto Laura — Variáveis de ambiente
# Copie este arquivo para .env e preencha com valores reais
# NUNCA commite o arquivo .env no Git
# ============================================================

# ----- Telegram -----
# Token obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Seu ID numérico do Telegram (obtenha via @userinfobot)
# Apenas este ID pode usar o bot
TELEGRAM_USER_ID=123456789

# ----- Claude API (Anthropic) -----
# Obtenha em: https://console.anthropic.com
CLAUDE_API_KEY=sua_chave_aqui

# Modelo padrão para extração de documentos (mais barato)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ----- Caminhos -----
# Caminho onde o OneDrive está montado na VM
ONEDRIVE_PATH=/mnt/onedrive

# Caminho do banco de dados SQLite
DB_PATH=/home/laura/laura-bot/data/laura.db

# ----- Projeto ativo -----
# Qual GGV está em execução (define pasta e numeração)
GGV_ATIVO=GGV03

# ----- Logs -----
# Nível: DEBUG (dev) ou INFO (produção)
LOG_LEVEL=INFO

# ----- Ambiente -----
# prod (padrão) ou test — test usa banco e pastas separados, sem afetar produção
# LAURA_ENV=test
