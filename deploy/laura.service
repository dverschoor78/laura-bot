[Unit]
Description=Laura - bot Telegram de compras (VII)
After=network-online.target rclone-onedrive.service
Wants=network-online.target rclone-onedrive.service

[Service]
Type=simple
WorkingDirectory=/opt/laura-bot
ExecStart=/opt/laura-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
